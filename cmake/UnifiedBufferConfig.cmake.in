@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The library may have been built against CUDA; the imported target references
# CUDA::cudart in that case.  Locate the toolkit (no-op if not needed).
find_dependency(CUDAToolkit QUIET)

include("${CMAKE_CURRENT_LIST_DIR}/UnifiedBufferTargets.cmake")

check_required_components(UnifiedBuffer)
